{"id":"quad_hyperbola_intersect","atoms":["func.quad_general.y_intercept","func.hyperbola.horizontal_asymptote","func.notation.evaluate"],"template":"A quadratic y = ax² + bx + {c_val} has axis of symmetry x = {axis_val}. A hyperbola y = k/(x−h){d_term} has its vertical asymptote at that same x-value and passes through the quadratic's y-intercept. Find k.","vars":{"c_val":{"type":"int","min":2,"max":12,"exclude":[0]},"axis_val":{"type":"int","min":1,"max":6},"d_val":{"type":"int","min":-4,"max":4,"exclude":[0]}},"derive":{"d_term":"term(d_val)"},"solver":"quad_hyperbola_intersect","graph":{"nodes":[{"node_id":"n1","atom_id":"func.quad_general.y_intercept","inputs":{"c_val":{"source":"question","field":"c_val","type":"expression"}},"expr":"c_val","outputs":{"value":{"type":"expression"}},"executor":"expr:quad_hyperbola_intersect.n1","verifier":"exact:quad_hyperbola_intersect.n1"},{"node_id":"n2","atom_id":"func.hyperbola.horizontal_asymptote","inputs":{"d_val":{"source":"question","field":"d_val","type":"expression"}},"expr":"d_val","outputs":{"value":{"type":"expression"}},"executor":"expr:quad_hyperbola_intersect.n2","verifier":"exact:quad_hyperbola_intersect.n2"},{"node_id":"n3","atom_id":"func.notation.evaluate","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"n2":{"source":"n2","field":"value","type":"expression"}},"expr":"n1 - n2","outputs":{"value":{"type":"expression"}},"executor":"expr:quad_hyperbola_intersect.n3","verifier":"exact:quad_hyperbola_intersect.n3"},{"node_id":"n4","atom_id":null,"inputs":{"axis_val":{"source":"question","field":"axis_val","type":"expression"},"n3":{"source":"n3","field":"value","type":"expression"}},"expr":"str(n3 * (-axis_val))","outputs":{"value":{"type":"expression"}},"executor":"expr:quad_hyperbola_intersect.n4","verifier":"exact:quad_hyperbola_intersect.n4"}],"final":"n4.value"}}
{"id":"hyperbola_limit_direction","atoms":["func.hyperbola.vertical_asymptote","func.hyperbola.horizontal_asymptote","func.notation.evaluate","func.pow.neg1"],"template":"For g(x) = {a_val}/(x−{b_val}){d_term}, is g({large_x}) greater than or less than the horizontal asymptote?","vars":{"a_val":{"type":"int","min":-9,"max":9,"exclude":[0]},"b_val":{"type":"int","min":1,"max":8},"d_val":{"type":"int","min":-5,"max":5,"exclude":[0]},"large_x":{"type":"int","min":100,"max":1000}},"derive":{"d_term":"term(d_val)"},"solver":"hyperbola_limit_direction","graph":{"nodes":[{"node_id":"n1","atom_id":"func.hyperbola.vertical_asymptote","inputs":{"b_val":{"source":"question","field":"b_val","type":"expression"}},"expr":"b_val","outputs":{"value":{"type":"expression"}},"executor":"expr:hyperbola_limit_direction.n1","verifier":"exact:hyperbola_limit_direction.n1"},{"node_id":"n2","atom_id":"func.hyperbola.horizontal_asymptote","inputs":{"d_val":{"source":"question","field":"d_val","type":"expression"}},"expr":"d_val","outputs":{"value":{"type":"expression"}},"executor":"expr:hyperbola_limit_direction.n2","verifier":"exact:hyperbola_limit_direction.n2"},{"node_id":"n3","atom_id":"func.notation.evaluate","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"large_x":{"source":"question","field":"large_x","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"},"n2":{"source":"n2","field":"value","type":"expression"}},"expr":"Fraction(a_val, large_x - n1) + n2","outputs":{"value":{"type":"expression"}},"executor":"expr:hyperbola_limit_direction.n3","verifier":"exact:hyperbola_limit_direction.n3"},{"node_id":"n4","atom_id":"func.pow.neg1","inputs":{"n2":{"source":"n2","field":"value","type":"expression"},"n3":{"source":"n3","field":"value","type":"expression"}},"expr":"'greater' if n3 > n2 else 'less'","outputs":{"value":{"type":"expression"}},"executor":"expr:hyperbola_limit_direction.n4","verifier":"exact:hyperbola_limit_direction.n4"}],"final":"n4.value"}}
{"id":"invprop_sqrt_solve","atoms":["func.inv_proportion.definition","func.power.sqrt"],"template":"y is inversely proportional to x, so y = k/x for a constant k. When x = {x_val}, y = {y_val}. Find x when √(k/x) = {target_val}.","vars":{"y_val":{"type":"int","min":6,"max":24},"x_val":{"type":"int","min":2,"max":6},"target_val":{"type":"int","min":1,"max":4,"exclude":[1]}},"solver":"invprop_sqrt_solve","graph":{"nodes":[{"node_id":"n1","atom_id":"func.inv_proportion.definition","inputs":{"x_val":{"source":"question","field":"x_val","type":"expression"},"y_val":{"source":"question","field":"y_val","type":"expression"}},"expr":"y_val * x_val","outputs":{"value":{"type":"expression"}},"executor":"expr:invprop_sqrt_solve.n1","verifier":"exact:invprop_sqrt_solve.n1"},{"node_id":"n2","atom_id":"func.power.sqrt","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"target_val":{"source":"question","field":"target_val","type":"expression"}},"expr":"str(Fraction(n1, target_val**2))","outputs":{"value":{"type":"expression"}},"executor":"expr:invprop_sqrt_solve.n2","verifier":"exact:invprop_sqrt_solve.n2"}],"final":"n2.value"}}
{"id":"asymptote_vertex_y","atoms":["func.hyperbola.vertical_asymptote","func.hyperbola.horizontal_asymptote","func.quad_general.axis","func.notation.evaluate"],"template":"The hyperbola y = {a_val}/(x−{b_val}){d_term} has vertical asymptote x = p and horizontal asymptote y = q. The quadratic y = {a_quad}x² + bx + q has axis of symmetry x = p. Find the y-coordinate of its vertex.","vars":{"a_val":{"type":"int","min":1,"max":9},"b_val":{"type":"int","min":1,"max":6},"d_val":{"type":"int","min":-4,"max":4,"exclude":[0]},"a_quad":{"type":"int","min":2,"max":3,"exclude":[0]}},"derive":{"d_term":"term(d_val)"},"solver":"asymptote_vertex_y","graph":{"nodes":[{"node_id":"n1","atom_id":"func.hyperbola.vertical_asymptote","inputs":{"b_val":{"source":"question","field":"b_val","type":"expression"}},"expr":"b_val","outputs":{"value":{"type":"expression"}},"executor":"expr:asymptote_vertex_y.n1","verifier":"exact:asymptote_vertex_y.n1"},{"node_id":"n2","atom_id":"func.hyperbola.horizontal_asymptote","inputs":{"d_val":{"source":"question","field":"d_val","type":"expression"}},"expr":"d_val","outputs":{"value":{"type":"expression"}},"executor":"expr:asymptote_vertex_y.n2","verifier":"exact:asymptote_vertex_y.n2"},{"node_id":"n3","atom_id":"func.quad_general.axis","inputs":{"a_quad":{"source":"question","field":"a_quad","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"-2 * a_quad * n1","outputs":{"value":{"type":"expression"}},"executor":"expr:asymptote_vertex_y.n3","verifier":"exact:asymptote_vertex_y.n3"},{"node_id":"n4","atom_id":"func.notation.evaluate","inputs":{"a_quad":{"source":"question","field":"a_quad","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"},"n2":{"source":"n2","field":"value","type":"expression"},"n3":{"source":"n3","field":"value","type":"expression"}},"expr":"str(a_quad*n1**2 + n3*n1 + n2)","outputs":{"value":{"type":"expression"}},"executor":"expr:asymptote_vertex_y.n4","verifier":"exact:asymptote_vertex_y.n4"}],"final":"n4.value"}}
{"id":"quadratic_expand_compare","atoms":["func.poly.quadratic_two_linear","func.poly.quadratic_repeated"],"template":"Expand (x−{a_val})(x−{b_val}) and (x−{rep_val})². Subtract the constant term of the first expansion from that of the second.","vars":{"a_val":{"type":"int","min":1,"max":9},"b_val":{"type":"int","min":1,"max":9,"exclude":["a_val"]},"rep_val":{"type":"int","min":1,"max":9}},"solver":"quadratic_expand_compare","graph":{"nodes":[{"node_id":"n1","atom_id":"func.poly.quadratic_two_linear","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"b_val":{"source":"question","field":"b_val","type":"expression"}},"expr":"a_val * b_val","outputs":{"value":{"type":"expression"}},"executor":"expr:quadratic_expand_compare.n1","verifier":"exact:quadratic_expand_compare.n1"},{"node_id":"n2","atom_id":"func.poly.quadratic_repeated","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"rep_val":{"source":"question","field":"rep_val","type":"expression"}},"expr":"str(rep_val*rep_val - n1)","outputs":{"value":{"type":"expression"}},"executor":"expr:quadratic_expand_compare.n2","verifier":"exact:quadratic_expand_compare.n2"}],"final":"n2.value"}}
{"id":"cubic_compare_forms","atoms":["func.poly.cubic_three_linear","func.poly.cubic_repeated"],"template":"Expand (x−{a_val})(x−{b_val})(x−{c_val}) and (x−{rep_val})³. Which expansion has the larger coefficient of x² — the first or the second?","vars":{"a_val":{"type":"int","min":1,"max":5},"b_val":{"type":"int","min":1,"max":5,"exclude":["a_val"]},"c_val":{"type":"int","min":1,"max":5,"exclude":["a_val","b_val"]},"rep_val":{"type":"int","min":1,"max":5}},"constraints":["a_val + b_val + c_val != 3 * rep_val"],"solver":"cubic_compare_forms","graph":{"nodes":[{"node_id":"n1","atom_id":"func.poly.cubic_three_linear","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"b_val":{"source":"question","field":"b_val","type":"expression"},"c_val":{"source":"question","field":"c_val","type":"expression"}},"expr":"-(a_val + b_val + c_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:cubic_compare_forms.n1","verifier":"exact:cubic_compare_forms.n1"},{"node_id":"n2","atom_id":"func.poly.cubic_repeated","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"rep_val":{"source":"question","field":"rep_val","type":"expression"}},"expr":"'first' if n1 > -3*rep_val else 'second'","outputs":{"value":{"type":"expression"}},"executor":"expr:cubic_compare_forms.n2","verifier":"exact:cubic_compare_forms.n2"}],"final":"n2.value"}}
{"id":"cubic_factor_quotient","atoms":["func.notation.evaluate","func.poly.factor_theorem","func.poly.cubic_factor_quotient"],"template":"For p(x) = x³{b_term}{c_term}{d_term}, give the quadratic quotient q(x) with p(x) = {fac}q(x), or answer 'not a factor'.","vars":{"a_val":{"type":"int","min":1,"max":6},"b_val":{"type":"int","min":-9,"max":9,"exclude":[0,1,-1]},"c_val":{"type":"int","min":-9,"max":9,"exclude":[0,1,-1]},"off":{"type":"choice","values":[0,0,0,0,0,0,1,-1,2,-2]}},"derive":{"d_val":"-(a_val**3 + b_val*a_val**2 + c_val*a_val) + off","b_term":"term(b_val, \"x²\")","c_term":"term(c_val, \"x\")","d_term":"term(d_val)","fac":"linfac(a_val)"},"constraints":["abs(d_val) > 1"],"solver":"cubic_factor_quotient","graph":{"nodes":[{"node_id":"n1","atom_id":"func.notation.evaluate","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"b_val":{"source":"question","field":"b_val","type":"expression"},"c_val":{"source":"question","field":"c_val","type":"expression"},"d_val":{"source":"question","field":"d_val","type":"expression"}},"expr":"poly_factor_theorem(a_val, b_val, c_val, d_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:cubic_factor_quotient.n1","verifier":"exact:cubic_factor_quotient.n1"},{"node_id":"n2","atom_id":"func.poly.factor_theorem","inputs":{"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"'factor' if n1 == 0 else 'not a factor'","outputs":{"value":{"type":"expression"}},"executor":"expr:cubic_factor_quotient.n2","verifier":"exact:cubic_factor_quotient.n2"},{"node_id":"n3","atom_id":"func.poly.cubic_factor_quotient","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"b_val":{"source":"question","field":"b_val","type":"expression"},"c_val":{"source":"question","field":"c_val","type":"expression"},"d_val":{"source":"question","field":"d_val","type":"expression"},"n2":{"source":"n2","field":"value","type":"expression"}},"expr":"poly_cubic_factor_quotient(a_val, b_val, c_val, d_val) if n2 == 'factor' else 'not a factor'","outputs":{"value":{"type":"expression"}},"executor":"expr:cubic_factor_quotient.n3","verifier":"exact:cubic_factor_quotient.n3"}],"final":"n3.value"}}
{"id":"circle_standard_point","atoms":["func.graph_relation.standard_circle","func.power.sqrt"],"template":"The circle x² + y² = {r_sq_val} passes through a point with x = {x_val}. Find the two possible values of y.","vars":{"r_val":{"type":"int","min":2,"max":10},"x_val":{"type":"int","min":-9,"max":9}},"derive":{"r_sq_val":"r_val * r_val"},"constraints":["abs(x_val) < r_val"],"solver":"circle_standard_point","graph":{"nodes":[{"node_id":"n1","atom_id":"func.graph_relation.standard_circle","inputs":{"r_sq_val":{"source":"question","field":"r_sq_val","type":"expression"},"x_val":{"source":"question","field":"x_val","type":"expression"}},"expr":"r_sq_val - x_val**2","outputs":{"value":{"type":"expression"}},"executor":"expr:circle_standard_point.n1","verifier":"exact:circle_standard_point.n1"},{"node_id":"n2","atom_id":"func.power.sqrt","inputs":{"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"'%s, -%s' % (sqrt(n1), sqrt(n1)) if n1 > 0 else ('0' if n1 == 0 else 'undefined')","outputs":{"value":{"type":"expression"}},"executor":"expr:circle_standard_point.n2","verifier":"exact:circle_standard_point.n2"}],"final":"n2.value"}}
{"id":"transform_horizontal_sequence","atoms":["func.transform.horizontal_translation","func.transform.horizontal_dilation"],"template":"Starting with f(x) = x², apply a horizontal dilation by factor 1/{k_val}, then translate {shift_phrase}. Write the final equation.","vars":{"k_val":{"type":"int","min":2,"max":5},"shift_val":{"type":"int","min":-6,"max":6,"exclude":[0]}},"derive":{"shift_phrase":"shift(shift_val, \"right\", \"left\")"},"solver":"transform_horizontal_sequence","graph":{"nodes":[{"node_id":"n1","atom_id":"func.transform.horizontal_translation","inputs":{"k_val":{"source":"question","field":"k_val","type":"expression"},"shift_val":{"source":"question","field":"shift_val","type":"expression"}},"expr":"shift_val * k_val","outputs":{"value":{"type":"expression"}},"executor":"expr:transform_horizontal_sequence.n1","verifier":"exact:transform_horizontal_sequence.n1"},{"node_id":"n2","atom_id":"func.transform.horizontal_dilation","inputs":{"k_val":{"source":"question","field":"k_val","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"('y = (%sx - %s)²' % (k_val, n1)) if n1 > 0 else ('y = (%sx + %s)²' % (k_val, -n1))","outputs":{"value":{"type":"expression"}},"executor":"expr:transform_horizontal_sequence.n2","verifier":"exact:transform_horizontal_sequence.n2"}],"final":"n2.value"}}
