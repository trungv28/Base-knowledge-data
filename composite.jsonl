{"id":"quad_hyperbola_intersect","unit":"MM1","atoms":["func.notation.evaluate","func.linear_solve.one_step"],"template":"The quadratic y = {qd} has a y-intercept. A hyperbola y = k/{fa}{d_term} passes through that y-intercept. Find k.","vars":{"c_val":{"type":"int","min":2,"max":12,"exclude":[0]},"axis_val":{"type":"int","min":1,"max":6},"d_val":{"type":"int","min":-4,"max":4,"exclude":[0]},"qa_val":{"type":"int","min":1,"max":4},"qb_val":{"type":"int","min":-6,"max":6}},"derive":{"d_term":"term(d_val)","qd":"quad(qa_val, qb_val, c_val)","fa":"linfac(axis_val)"},"constraints":["c_val != d_val"],"solver":"quad_hyperbola_intersect"}
{"id":"transform_horizontal_dilation_eval","unit":"MM1","atoms":["func.transform.horizontal_translation","func.transform.horizontal_dilation","func.notation.evaluate"],"template":"Starting with f(x) = x², apply a horizontal dilation by factor 1/{k_val}, then translate {h_phrase}. Evaluate the transformed function at x = {eval_x}.","vars":{"k_val":{"type":"int","min":2,"max":5},"h_val":{"type":"int","min":-6,"max":6,"exclude":[0]},"eval_x":{"type":"int","min":-5,"max":5}},"derive":{"h_phrase":"shift(h_val, \"right\", \"left\")"},"constraints":["eval_x != h_val"],"solver":"transform_horizontal_dilation_eval"}
{"id":"quad_axis_evaluate","unit":"MM1","atoms":["func.quad_general.axis","func.notation.evaluate"],"template":"For y = {qd}, find the y-coordinate of the vertex.","vars":{"a_val":{"type":"int","min":2,"max":5},"b_val":{"type":"int","min":-9,"max":9,"exclude":[0,1,-1]},"c_val":{"type":"int","min":-9,"max":9,"exclude":[0]}},"derive":{"b_term":"term(b_val, \"x\")","c_term":"term(c_val)","qd":"quad(a_val,b_val,c_val)"},"solver":"quad_axis_evaluate"}
{"id":"cubic_intercept_translate","unit":"MM1","atoms":["func.notation.evaluate","func.transform.vertical_translation"],"template":"The cubic y = {cb} is translated {v_phrase}. Find the y-coordinate of the point on the translated curve where x = {e_val}.","vars":{"b_val":{"type":"int","min":-9,"max":9},"c_val":{"type":"int","min":-9,"max":9},"d_val":{"type":"int","min":-20,"max":20,"exclude":[0]},"e_val":{"type":"int","min":-4,"max":4,"exclude":[0]},"v_val":{"type":"int","min":-9,"max":9,"exclude":[0]}},"derive":{"cb":"cubic(1,b_val,c_val,d_val)","v_phrase":"shift(v_val, 'up', 'down')"},"constraints":[],"solver":"cubic_intercept_translate"}
{"id":"transform_vertical_sequence_eval","unit":"MM1","atoms":["func.notation.evaluate","func.transform.vertical_dilation","func.transform.vertical_translation"],"template":"f(x) = x² is dilated vertically by factor {c_val}, then translated {v_phrase}. Evaluate the result at x = {e_val}.","vars":{"c_val":{"type":"int","min":2,"max":6},"v_val":{"type":"int","min":-9,"max":9,"exclude":[0]},"e_val":{"type":"int","min":-5,"max":5,"exclude":[0]}},"derive":{"v_phrase":"shift(v_val, \"up\", \"down\")"},"solver":"transform_vertical_sequence_eval"}
{"id":"transform_hdilate_translate_eval","unit":"MM1","atoms":["func.transform.horizontal_dilation","func.notation.evaluate","func.transform.vertical_translation"],"template":"f(x) = x² is dilated horizontally by factor 1/{k_val}, then translated {v_phrase}. Evaluate the result at x = {e_val}.","vars":{"k_val":{"type":"int","min":2,"max":5},"v_val":{"type":"int","min":-9,"max":9,"exclude":[0]},"e_val":{"type":"int","min":-5,"max":5,"exclude":[0]}},"derive":{"v_phrase":"shift(v_val, \"up\", \"down\")"},"solver":"transform_hdilate_translate_eval"}
{"id":"hyperbola_translate_evaluate","unit":"MM1","atoms":["func.transform.horizontal_translation","func.notation.evaluate"],"template":"The hyperbola y = {a_val}/(x−{b_val}){d_term} is translated {h_phrase}. Find the value of the translated function at x = {e_val}.","vars":{"a_val":{"type":"int","min":1,"max":9},"b_val":{"type":"int","min":1,"max":6},"d_val":{"type":"int","min":-5,"max":5,"exclude":[0]},"h_val":{"type":"int","min":-4,"max":4,"exclude":[0]},"e_val":{"type":"int","min":-8,"max":8}},"derive":{"d_term":"term(d_val)","h_phrase":"shift(h_val, \"right\", \"left\")"},"constraints":["e_val != b_val + h_val"],"solver":"hyperbola_translate_evaluate"}
{"id":"invprop_shifted_evaluate","unit":"MM1","atoms":["func.inv_proportion.definition","func.notation.evaluate","func.transform.vertical_translation"],"template":"y is inversely proportional to x, and y = {y1_val} when x = {x1_val}. The graph of this relationship is translated {v_phrase}. Find the value of the translated curve at x = {x2_val}.","vars":{"y1_val":{"type":"int","min":2,"max":12},"x1_val":{"type":"int","min":2,"max":9},"x2_val":{"type":"int","min":2,"max":12},"v_val":{"type":"int","min":-6,"max":6,"exclude":[0]}},"derive":{"v_phrase":"shift(v_val, \"up\", \"down\")"},"constraints":["x2_val != x1_val"],"solver":"invprop_shifted_evaluate"}
{"id":"directprop_evaluate","unit":"MM1","atoms":["func.direct_proportion.constant_ratio","func.notation.evaluate"],"template":"z is directly proportional to x, and z = {z1_val} when x = {x1_val}. Find z when x = {x2_val}.","vars":{"k_val":{"type":"int","min":2,"max":9},"x1_val":{"type":"int","min":2,"max":9},"x2_val":{"type":"int","min":2,"max":12}},"derive":{"z1_val":"k_val * x1_val"},"constraints":["x2_val != x1_val"],"solver":"directprop_evaluate"}
{"id":"quad_vertex_below_intercept","unit":"MM1","atoms":["func.quad_general.y_intercept","func.quad_general.axis","func.notation.evaluate"],"template":"For y = {a_val}x²{b_term}{c_term}, how far above the vertex is the y-intercept?","vars":{"a_val":{"type":"int","min":2,"max":5},"b_val":{"type":"int","min":-9,"max":9,"exclude":[0,1,-1]},"c_val":{"type":"int","min":-9,"max":9,"exclude":[0]}},"derive":{"b_term":"term(b_val, \"x\")","c_term":"term(c_val)"},"solver":"quad_vertex_below_intercept"}
{"id":"quad_two_linear_translate","unit":"MM1","atoms":["func.poly.quadratic_two_linear","func.transform.vertical_translation"],"template":"The parabola y = {fa}{fb} is translated {v_phrase}. Write the result in the form x² + px + q.","vars":{"a_val":{"type":"int","min":1,"max":9},"b_val":{"type":"int","min":1,"max":9,"exclude":["a_val"]},"v_val":{"type":"int","min":-9,"max":9,"exclude":[0]}},"derive":{"v_phrase":"shift(v_val, \"up\", \"down\")","fa":"linfac(a_val)","fb":"linfac(b_val)"},"solver":"quad_two_linear_translate"}
{"id":"quad_repeated_dilate","unit":"MM1","atoms":["func.poly.quadratic_repeated","func.transform.vertical_dilation"],"template":"The parabola y = {fa}² is dilated vertically by factor {c_val}. Write the result in the form px² + qx + r.","vars":{"a_val":{"type":"int","min":-12,"max":12,"exclude":[0]},"c_val":{"type":"int","min":2,"max":8}},"derive":{"fa":"linfac(a_val)"},"solver":"quad_repeated_dilate"}
{"id":"transform_chain_evaluate","unit":"MM1","atoms":["func.transform.horizontal_translation","func.notation.evaluate","func.transform.vertical_dilation","func.transform.vertical_translation"],"template":"f(x) = x² is dilated vertically by factor {c_val}, then translated {v_phrase}, then translated {h_phrase}. Find the y-value of the result at x = {e_val}.","vars":{"c_val":{"type":"int","min":2,"max":6},"v_val":{"type":"int","min":-9,"max":9,"exclude":[0]},"h_val":{"type":"int","min":-5,"max":5,"exclude":[0]},"e_val":{"type":"int","min":-6,"max":6}},"derive":{"v_phrase":"shift(v_val, \"up\", \"down\")","h_phrase":"shift(h_val, \"right\", \"left\")"},"constraints":["e_val != h_val"],"solver":"transform_chain_evaluate"}
{"id":"transform_full_chain_evaluate","unit":"MM1","atoms":["func.transform.horizontal_translation","func.transform.horizontal_dilation","func.notation.evaluate","func.transform.vertical_dilation","func.transform.vertical_translation"],"template":"f(x) = x² is dilated horizontally by factor 1/{k_val}, then translated {h_phrase}, then dilated vertically by factor {c_val}, then translated {v_phrase}. Find the y-value of the result at x = {e_val}.","vars":{"k_val":{"type":"int","min":2,"max":4},"c_val":{"type":"int","min":2,"max":5},"h_val":{"type":"int","min":-5,"max":5,"exclude":[0]},"v_val":{"type":"int","min":-9,"max":9,"exclude":[0]},"e_val":{"type":"int","min":-6,"max":6}},"derive":{"h_phrase":"shift(h_val, \"right\", \"left\")","v_phrase":"shift(v_val, \"up\", \"down\")"},"constraints":["e_val != h_val"],"solver":"transform_full_chain_evaluate"}
{"id":"transform_chain_inverse","unit":"MM1","atoms":["func.transform.vertical_translation","func.transform.vertical_dilation","func.sqrt.principal","func.transform.horizontal_dilation","func.transform.horizontal_translation"],"template":"f(x) = x² is dilated horizontally by factor 1/{k_val}, then translated {h_phrase}, then dilated vertically by factor {c_val}, then translated {v_phrase}. The result passes through the point (x, {y_val}) with x > {h_val}. Find x.","vars":{"k_val":{"type":"int","min":2,"max":4},"c_val":{"type":"int","min":2,"max":5},"h_val":{"type":"int","min":-5,"max":5,"exclude":[0]},"v_val":{"type":"int","min":-9,"max":9,"exclude":[0]},"m_val":{"type":"int","min":1,"max":5}},"derive":{"h_phrase":"shift(h_val, \"right\", \"left\")","v_phrase":"shift(v_val, \"up\", \"down\")","y_val":"c_val * (k_val * m_val)**2 + v_val"},"solver":"transform_chain_inverse"}
{"id":"quad_translate_intercept_gap","unit":"MM1","atoms":["func.quad_general.axis","func.notation.evaluate","func.transform.horizontal_translation","func.transform.vertical_translation"],"template":"The parabola y = {qd} is translated {h_phrase} and {v_phrase}. Find the vertex of the translated parabola.","vars":{"a_val":{"type":"int","min":2,"max":5},"b_val":{"type":"int","min":-9,"max":9,"exclude":[0,1,-1]},"c_val":{"type":"int","min":-9,"max":9,"exclude":[0]},"h_val":{"type":"int","min":-5,"max":5,"exclude":[0]},"v_val":{"type":"int","min":-9,"max":9,"exclude":[0]}},"derive":{"b_term":"term(b_val, \"x\")","c_term":"term(c_val)","h_phrase":"shift(h_val, \"right\", \"left\")","v_phrase":"shift(v_val, \"up\", \"down\")","qd":"quad(a_val, b_val, c_val)"},"solver":"quad_translate_intercept_gap"}
{"id":"quad_axis_translate","unit":"MM1","atoms":["func.quad_general.axis","func.transform.horizontal_translation"],"template":"The parabola y = {qd} is translated {h_phrase}. Find the x-coordinate of the axis of symmetry of the translated parabola.","vars":{"a_val":{"type":"int","min":2,"max":5},"b_val":{"type":"int","min":-9,"max":9,"exclude":[0,1,-1]},"c_val":{"type":"int","min":-9,"max":9,"exclude":[0]},"h_val":{"type":"int","min":-5,"max":5,"exclude":[0]}},"derive":{"b_term":"term(b_val, \"x\")","c_term":"term(c_val)","h_phrase":"shift(h_val, \"right\", \"left\")","qd":"quad(a_val,b_val,c_val)"},"solver":"quad_axis_translate"}
{"id":"quad_vertex_translate","unit":"MM1","atoms":["func.quad_general.axis","func.notation.evaluate","func.transform.vertical_translation"],"template":"The parabola y = {a_val}x²{b_term}{c_term} is translated {v_phrase}. Find the y-coordinate of the vertex of the translated parabola.","vars":{"a_val":{"type":"int","min":2,"max":5},"b_val":{"type":"int","min":-9,"max":9,"exclude":[0,1,-1]},"c_val":{"type":"int","min":-9,"max":9,"exclude":[0]},"v_val":{"type":"int","min":-9,"max":9,"exclude":[0]}},"derive":{"b_term":"term(b_val, \"x\")","c_term":"term(c_val)","v_phrase":"shift(v_val, \"up\", \"down\")"},"solver":"quad_vertex_translate"}
{"id":"factor_theorem_shift","unit":"MM1","atoms":["func.notation.evaluate","func.transform.vertical_translation","func.poly.factor_theorem"],"template":"For p(x) = x³{b_term}{c_term}{d_term}, is (x−{a_val}) a factor of p(x){v_term}?","vars":{"a_val":{"type":"int","min":1,"max":6},"r1_val":{"type":"int","min":-6,"max":6,"exclude":[0]},"r2_val":{"type":"int","min":-6,"max":6,"exclude":[0,"r1_val"]},"v_val":{"type":"choice","values":[3,-3,5,-5]},"hit":{"type":"choice","values":[0,1]}},"derive":{"b_val":"-(a_val + r1_val + r2_val)","c_val":"a_val*r1_val + a_val*r2_val + r1_val*r2_val","off":"-v_val if hit else 0","d_val":"-(a_val * r1_val * r2_val) + off","b_term":"term(b_val, \"x²\")","c_term":"term(c_val, \"x\")","d_term":"term(d_val)","v_term":"term(v_val)"},"constraints":["abs(b_val) > 1","abs(c_val) > 1","abs(d_val) > 1"],"solver":"factor_theorem_shift"}
{"id":"cubic_quotient_vertex_translate","unit":"MM1","atoms":["func.poly.cubic_factor_quotient","func.quad_general.axis","func.notation.evaluate","func.transform.vertical_translation"],"template":"The cubic p(x) = {cb} has {fa} as a factor. Divide p(x) by {fa}, find the turning point of the quotient, then translate the quotient {sh}. Give the y-coordinate of the new turning point.","vars":{"a_val":{"type":"int","min":1,"max":5},"b_val":{"type":"int","min":-7,"max":3},"c_val":{"type":"int","min":-6,"max":6},"v_val":{"type":"int","min":-8,"max":8,"exclude":[0]}},"derive":{"d_val":"-(a_val**3 + b_val*a_val**2 + c_val*a_val)","cb":"cubic(1, b_val, c_val, d_val)","fa":"linfac(a_val)","sh":"shift(v_val, 'up', 'down')"},"solver":"cubic_quotient_vertex_translate"}
