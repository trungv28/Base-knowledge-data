{"id":"combination_sum_adjacent","atoms":["prob.pascal.interior_entry","prob.combination.formula"],"template":"C({n_val}, {r_val}) + C({n_val}, {r_plus_1_val}) equals a single binomial coefficient C(N, {r_plus_1_val}). Find its value.","vars":{"n_val":{"type":"int","min":5,"max":12},"r_val":{"type":"int","min":1,"max":5}},"derive":{"r_plus_1_val":"r_val + 1"},"constraints":["r_plus_1_val <= n_val"],"solver":"combination_sum_adjacent","graph":{"nodes":[{"node_id":"n1","atom_id":"prob.pascal.interior_entry","inputs":{"n_val":{"source":"question","field":"n_val","type":"expression"}},"expr":"n_val + 1","outputs":{"value":{"type":"expression"}},"executor":"expr:combination_sum_adjacent.n1","verifier":"exact:combination_sum_adjacent.n1"},{"node_id":"n2","atom_id":"prob.combination.formula","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"r_plus_1_val":{"source":"question","field":"r_plus_1_val","type":"expression"}},"expr":"str(comb(n1, r_plus_1_val))","outputs":{"value":{"type":"expression"}},"executor":"expr:combination_sum_adjacent.n2","verifier":"exact:combination_sum_adjacent.n2"}],"final":"n2.value"}}
{"id":"binom_specific_term_value","atoms":["prob.binom.form","prob.binom.coeff"],"template":"For (2x+y)^{n_val}, find the coefficient of x^{n_minus_k_val}y^{k_val}.","vars":{"n_val":{"type":"int","min":4,"max":10},"k_val":{"type":"int","min":0,"max":6}},"derive":{"n_minus_k_val":"n_val - k_val"},"constraints":["k_val >= 1","k_val <= n_val - 1"],"solver":"binom_specific_term_value","graph":{"nodes":[{"node_id":"n1","atom_id":"prob.binom.form","inputs":{"n_minus_k_val":{"source":"question","field":"n_minus_k_val","type":"expression"}},"expr":"2 ** n_minus_k_val","outputs":{"value":{"type":"expression"}},"executor":"expr:binom_specific_term_value.n1","verifier":"exact:binom_specific_term_value.n1"},{"node_id":"n2","atom_id":"prob.binom.coeff","inputs":{"k_val":{"source":"question","field":"k_val","type":"expression"},"n_val":{"source":"question","field":"n_val","type":"expression"}},"expr":"comb(n_val, k_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:binom_specific_term_value.n2","verifier":"exact:binom_specific_term_value.n2"},{"node_id":"n3","atom_id":null,"inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"n2":{"source":"n2","field":"value","type":"expression"}},"expr":"str(n1 * n2)","outputs":{"value":{"type":"expression"}},"executor":"expr:binom_specific_term_value.n3","verifier":"exact:binom_specific_term_value.n3"}],"final":"n3.value"}}
{"id":"pascal_symmetry_sum","atoms":["prob.combination.formula","prob.combination.symmetry","prob.pascal.row_sum"],"template":"In row {n_val} of Pascal's triangle, express C({n_val}, {r_val}) + C({n_val}, {n_minus_r_val}) as a fraction of the row sum 2^{n_val}.","vars":{"n_val":{"type":"int","min":4,"max":12},"r_val":{"type":"int","min":1,"max":6}},"derive":{"n_minus_r_val":"n_val - r_val"},"constraints":["r_val < n_val","2 * r_val != n_val"],"solver":"pascal_symmetry_sum","graph":{"nodes":[{"node_id":"n1","atom_id":"prob.combination.formula","inputs":{"n_val":{"source":"question","field":"n_val","type":"expression"},"r_val":{"source":"question","field":"r_val","type":"expression"}},"expr":"comb(n_val, r_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:pascal_symmetry_sum.n1","verifier":"exact:pascal_symmetry_sum.n1"},{"node_id":"n2","atom_id":"prob.combination.symmetry","inputs":{"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"2 * n1","outputs":{"value":{"type":"expression"}},"executor":"expr:pascal_symmetry_sum.n2","verifier":"exact:pascal_symmetry_sum.n2"},{"node_id":"n3","atom_id":"prob.pascal.row_sum","inputs":{"n_val":{"source":"question","field":"n_val","type":"expression"}},"expr":"2 ** n_val","outputs":{"value":{"type":"expression"}},"executor":"expr:pascal_symmetry_sum.n3","verifier":"exact:pascal_symmetry_sum.n3"},{"node_id":"n4","atom_id":null,"inputs":{"n2":{"source":"n2","field":"value","type":"expression"},"n3":{"source":"n3","field":"value","type":"expression"}},"expr":"pf(n2, n3)","outputs":{"value":{"type":"expression"}},"executor":"expr:pascal_symmetry_sum.n4","verifier":"exact:pascal_symmetry_sum.n4"}],"final":"n4.value"}}
{"id":"event_complement_size","atoms":["prob.set.complement","prob.equally_likely.formula"],"template":"The sample space S has {total_val} outcomes. Event A has {a_val} outcomes. What fraction of S is not in A?","vars":{"total_val":{"type":"int","min":10,"max":50},"a_val":{"type":"int","min":1,"max":25}},"constraints":["a_val < total_val"],"solver":"event_complement_size","graph":{"nodes":[{"node_id":"n1","atom_id":"prob.set.complement","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"total_val":{"source":"question","field":"total_val","type":"expression"}},"expr":"total_val - a_val","outputs":{"value":{"type":"expression"}},"executor":"expr:event_complement_size.n1","verifier":"exact:event_complement_size.n1"},{"node_id":"n2","atom_id":"prob.equally_likely.formula","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"total_val":{"source":"question","field":"total_val","type":"expression"}},"expr":"pf(n1, total_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:event_complement_size.n2","verifier":"exact:event_complement_size.n2"}],"final":"n2.value"}}
{"id":"repeated_root_third","atoms":["func.poly.repeated_root","func.poly.cubic_repeated_distinct"],"template":"The cubic p(x) = x³{b_term}{c_term}{d_term} has a repeated root at x = {root_val}. Find its other root.","vars":{"root_val":{"type":"int","min":-6,"max":6,"exclude":[0]},"other_val":{"type":"int","min":-6,"max":6,"exclude":[0,"root_val"]}},"derive":{"b_val":"-(2*root_val + other_val)","c_val":"root_val**2 + 2*root_val*other_val","d_val":"-(root_val**2 * other_val)","b_term":"term(b_val, \"x²\")","c_term":"term(c_val, \"x\")","d_term":"term(d_val)"},"constraints":["abs(b_val) > 1","abs(c_val) > 1","abs(d_val) > 1"],"solver":"repeated_root_third","graph":{"nodes":[{"node_id":"n1","atom_id":"func.poly.repeated_root","inputs":{"root_val":{"source":"question","field":"root_val","type":"expression"}},"expr":"2 * root_val","outputs":{"value":{"type":"expression"}},"executor":"expr:repeated_root_third.n1","verifier":"exact:repeated_root_third.n1"},{"node_id":"n2","atom_id":"func.poly.cubic_repeated_distinct","inputs":{"b_val":{"source":"question","field":"b_val","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"str(-b_val - n1)","outputs":{"value":{"type":"expression"}},"executor":"expr:repeated_root_third.n2","verifier":"exact:repeated_root_third.n2"}],"final":"n2.value"}}
