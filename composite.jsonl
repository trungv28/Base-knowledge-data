{"id":"transform_compare_outputs","atoms":["func.transform.vertical_dilation","func.transform.vertical_translation"],"template":"For f(x) = x², compare two orders: (1) dilate vertically by {c_val}, then translate {a_phrase}; (2) translate {a_phrase}, then dilate vertically by {c_val}. At x = {eval_x}, which gives the larger y-value — the first or the second?","vars":{"c_val":{"type":"int","min":2,"max":5},"a_val":{"type":"int","min":-9,"max":9,"exclude":[0]},"eval_x":{"type":"int","min":1,"max":5}},"derive":{"a_phrase":"shift(a_val, \"up\", \"down\")"},"solver":"transform_compare_outputs","graph":{"nodes":[{"node_id":"n1","atom_id":"func.transform.vertical_dilation","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"c_val":{"source":"question","field":"c_val","type":"expression"},"eval_x":{"source":"question","field":"eval_x","type":"expression"}},"expr":"c_val * eval_x**2 + a_val","outputs":{"value":{"type":"expression"}},"executor":"expr:transform_compare_outputs.n1","verifier":"exact:transform_compare_outputs.n1"},{"node_id":"n2","atom_id":"func.transform.vertical_translation","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"c_val":{"source":"question","field":"c_val","type":"expression"},"eval_x":{"source":"question","field":"eval_x","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"'first' if n1 > c_val*(eval_x**2 + a_val) else 'second'","outputs":{"value":{"type":"expression"}},"executor":"expr:transform_compare_outputs.n2","verifier":"exact:transform_compare_outputs.n2"}],"final":"n2.value"}}
