{"id":"sin_equation_special_angles","atoms":["trig.exact_values.special_angles","trig.period.sin_base","trig.period.linear_argument_scaling","trig.equation.sin_special"],"template":"Solve sin({B}x + {C}) = {a_value} for x in the interval 0 ≤ x < 2π/{B}.","cases":[{"a_choice":0,"a_value":"0","theta1":"0","theta2":"π","t1n":0,"t1d":1,"t2n":1,"t2d":1},{"a_choice":1,"a_value":"1/2","theta1":"π/6","theta2":"5π/6","t1n":1,"t1d":6,"t2n":5,"t2d":6},{"a_choice":2,"a_value":"1","theta1":"π/2","theta2":"π/2","t1n":1,"t1d":2,"t2n":1,"t2d":2},{"a_choice":3,"a_value":"√3/2","theta1":"π/3","theta2":"2π/3","t1n":1,"t1d":3,"t2n":2,"t2d":3},{"a_choice":4,"a_value":"-1/2","theta1":"7π/6","theta2":"11π/6","t1n":7,"t1d":6,"t2n":11,"t2d":6},{"a_choice":5,"a_value":"-√3/2","theta1":"4π/3","theta2":"5π/3","t1n":4,"t1d":3,"t2n":5,"t2d":3}],"vars":{"B":{"type":"int","min":1,"max":12},"C":{"type":"int","min":-6,"max":6}},"solver":"sin_equation_special_angles","graph":{"nodes":[{"node_id":"n1","atom_id":"trig.exact_values.special_angles","inputs":{"C":{"source":"question","field":"C","type":"expression"},"a_value":{"source":"question","field":"a_value","type":"expression"}},"expr":"pi_coeff(sin_base_angle(a_value, 0) + 2*int(ceiling((C - sin_base_angle(a_value, 0)*pi)/(2*pi))))","outputs":{"value":{"type":"expression"}},"executor":"expr:sin_equation_special_angles.n1","verifier":"exact:sin_equation_special_angles.n1"},{"node_id":"n2","atom_id":"trig.exact_values.special_angles","inputs":{"C":{"source":"question","field":"C","type":"expression"},"a_value":{"source":"question","field":"a_value","type":"expression"}},"expr":"pi_coeff(sin_base_angle(a_value, 1) + 2*int(ceiling((C - sin_base_angle(a_value, 1)*pi)/(2*pi))))","outputs":{"value":{"type":"expression"}},"executor":"expr:sin_equation_special_angles.n2","verifier":"exact:sin_equation_special_angles.n2"},{"node_id":"n3","atom_id":"trig.period.sin_base","inputs":{},"expr":"'2π'","outputs":{"value":{"type":"expression"}},"executor":"expr:sin_equation_special_angles.n3","verifier":"exact:sin_equation_special_angles.n3"},{"node_id":"n4","atom_id":"trig.period.linear_argument_scaling","inputs":{"B":{"source":"question","field":"B","type":"expression"},"n3":{"source":"n3","field":"value","type":"expression"}},"expr":"'%s/%d' % (n3, abs(B))","outputs":{"value":{"type":"expression"}},"executor":"expr:sin_equation_special_angles.n4","verifier":"exact:sin_equation_special_angles.n4"},{"node_id":"n5","atom_id":"trig.equation.sin_special","inputs":{"B":{"source":"question","field":"B","type":"expression"},"C":{"source":"question","field":"C","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"},"n2":{"source":"n2","field":"value","type":"expression"},"n4":{"source":"n4","field":"value","type":"expression"}},"expr":"{'solution1': '(%s - %s)/%s' % (n1, C, B), 'solution2': '(%s - %s)/%s' % (n2, C, B), 'period': n4}","outputs":{"value":{"type":"expression"}},"executor":"expr:sin_equation_special_angles.n5","verifier":"exact:sin_equation_special_angles.n5"}],"final":"n5.value"}}
{"id":"quad_hyperbola_intersect","atoms":["func.quad_general.y_intercept","func.quad_general.axis","func.hyperbola.horizontal_asymptote"],"template":"A quadratic y = ax² + bx + {c_val} has axis of symmetry x = {axis_val}. A hyperbola y = k/(x−h) + {d_val} has vertical asymptote at x = h where h equals the axis value, and passes through the quadratic's y-intercept. Find k.","vars":{"c_val":{"type":"int","min":2,"max":12,"exclude":[0]},"axis_val":{"type":"int","min":1,"max":6},"d_val":{"type":"int","min":-4,"max":4,"exclude":[0]}},"solver":"quad_hyperbola_intersect","graph":{"nodes":[{"node_id":"n1","atom_id":"func.quad_general.y_intercept","inputs":{"c_val":{"source":"question","field":"c_val","type":"expression"}},"expr":"c_val","outputs":{"value":{"type":"expression"}},"executor":"expr:quad_hyperbola_intersect.n1","verifier":"exact:quad_hyperbola_intersect.n1"},{"node_id":"n2","atom_id":"func.quad_general.axis","inputs":{"axis_val":{"source":"question","field":"axis_val","type":"expression"}},"expr":"axis_val","outputs":{"value":{"type":"expression"}},"executor":"expr:quad_hyperbola_intersect.n2","verifier":"exact:quad_hyperbola_intersect.n2"},{"node_id":"n3","atom_id":"func.hyperbola.horizontal_asymptote","inputs":{"d_val":{"source":"question","field":"d_val","type":"expression"}},"expr":"d_val","outputs":{"value":{"type":"expression"}},"executor":"expr:quad_hyperbola_intersect.n3","verifier":"exact:quad_hyperbola_intersect.n3"},{"node_id":"n4","atom_id":null,"inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"n2":{"source":"n2","field":"value","type":"expression"},"n3":{"source":"n3","field":"value","type":"expression"}},"expr":"str((n1 - n3) * (-n2))","outputs":{"value":{"type":"expression"}},"executor":"expr:quad_hyperbola_intersect.n4","verifier":"exact:quad_hyperbola_intersect.n4"}],"final":"n4.value"}}
{"id":"hyperbola_limit_direction","atoms":["func.hyperbola.vertical_asymptote","func.hyperbola.horizontal_asymptote","func.pow.neg1"],"template":"For g(x) = {a_val}/(x−{b_val}) + {d_val}, find the horizontal asymptote. Then determine if g({large_x}) is greater than or less than this asymptote value.","vars":{"a_val":{"type":"int","min":-9,"max":9,"exclude":[0]},"b_val":{"type":"int","min":1,"max":8},"d_val":{"type":"int","min":-5,"max":5},"large_x":{"type":"int","min":100,"max":1000}},"solver":"hyperbola_limit_direction","graph":{"nodes":[{"node_id":"n1","atom_id":"func.hyperbola.vertical_asymptote","inputs":{"b_val":{"source":"question","field":"b_val","type":"expression"}},"expr":"b_val","outputs":{"value":{"type":"expression"}},"executor":"expr:hyperbola_limit_direction.n1","verifier":"exact:hyperbola_limit_direction.n1"},{"node_id":"n2","atom_id":"func.hyperbola.horizontal_asymptote","inputs":{"d_val":{"source":"question","field":"d_val","type":"expression"}},"expr":"d_val","outputs":{"value":{"type":"expression"}},"executor":"expr:hyperbola_limit_direction.n2","verifier":"exact:hyperbola_limit_direction.n2"},{"node_id":"n3","atom_id":"func.pow.neg1","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"large_x":{"source":"question","field":"large_x","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"},"n2":{"source":"n2","field":"value","type":"expression"}},"expr":"'greater' if Fraction(a_val, large_x - n1) + n2 > n2 else 'less'","outputs":{"value":{"type":"expression"}},"executor":"expr:hyperbola_limit_direction.n3","verifier":"exact:hyperbola_limit_direction.n3"}],"final":"n3.value"}}
{"id":"invprop_sqrt_solve","atoms":["func.inv_proportion.definition","func.power.sqrt"],"template":"y is inversely proportional to x. When x = {x_val}, y = {y_val}. Find x when √(k/x) = {target_val}.","vars":{"y_val":{"type":"int","min":6,"max":24},"x_val":{"type":"int","min":2,"max":6},"target_val":{"type":"int","min":1,"max":4}},"solver":"invprop_sqrt_solve","graph":{"nodes":[{"node_id":"n1","atom_id":"func.inv_proportion.definition","inputs":{"x_val":{"source":"question","field":"x_val","type":"expression"},"y_val":{"source":"question","field":"y_val","type":"expression"}},"expr":"y_val * x_val","outputs":{"value":{"type":"expression"}},"executor":"expr:invprop_sqrt_solve.n1","verifier":"exact:invprop_sqrt_solve.n1"},{"node_id":"n2","atom_id":"func.power.sqrt","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"target_val":{"source":"question","field":"target_val","type":"expression"}},"expr":"str(Fraction(n1, target_val**2))","outputs":{"value":{"type":"expression"}},"executor":"expr:invprop_sqrt_solve.n2","verifier":"exact:invprop_sqrt_solve.n2"}],"final":"n2.value"}}
{"id":"hyperbola_quad_axis","atoms":["func.hyperbola.vertical_asymptote","func.quad_general.axis"],"template":"A hyperbola y = a/(x−{b_val}) + d has vertical asymptote x = {b_val}. A quadratic y = x² + bx + {c_val} has its axis of symmetry at the same x-value. Find b.","vars":{"b_val":{"type":"int","min":2,"max":12},"c_val":{"type":"int","min":4,"max":12}},"derive":{"axis_val":"b_val"},"solver":"hyperbola_quad_axis","graph":{"nodes":[{"node_id":"n1","atom_id":"func.hyperbola.vertical_asymptote","inputs":{"b_val":{"source":"question","field":"b_val","type":"expression"}},"expr":"b_val","outputs":{"value":{"type":"expression"}},"executor":"expr:hyperbola_quad_axis.n1","verifier":"exact:hyperbola_quad_axis.n1"},{"node_id":"n2","atom_id":"func.quad_general.axis","inputs":{"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"str(-2 * n1)","outputs":{"value":{"type":"expression"}},"executor":"expr:hyperbola_quad_axis.n2","verifier":"exact:hyperbola_quad_axis.n2"}],"final":"n2.value"}}
{"id":"power_eval_compare","atoms":["func.pow.natural_even","func.pow.natural_odd"],"template":"Evaluate f(x) = x^{n_even}, g(x) = x^{n_odd}, and h(x) = √x at x = {eval_val}. Which gives the largest output?","vars":{"n_even":{"type":"choice","values":[2,4,6]},"n_odd":{"type":"choice","values":[3,5,7]},"eval_val":{"type":"int","min":2,"max":5},"neg_val":{"type":"int","min":-5,"max":-1}},"solver":"power_eval_compare","graph":{"nodes":[{"node_id":"n1","atom_id":"func.pow.natural_even","inputs":{"eval_val":{"source":"question","field":"eval_val","type":"expression"},"n_even":{"source":"question","field":"n_even","type":"expression"}},"expr":"eval_val ** n_even","outputs":{"value":{"type":"expression"}},"executor":"expr:power_eval_compare.n1","verifier":"exact:power_eval_compare.n1"},{"node_id":"n2","atom_id":"func.pow.natural_odd","inputs":{"eval_val":{"source":"question","field":"eval_val","type":"expression"},"n_odd":{"source":"question","field":"n_odd","type":"expression"}},"expr":"eval_val ** n_odd","outputs":{"value":{"type":"expression"}},"executor":"expr:power_eval_compare.n2","verifier":"exact:power_eval_compare.n2"},{"node_id":"n3","atom_id":null,"inputs":{"eval_val":{"source":"question","field":"eval_val","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"},"n2":{"source":"n2","field":"value","type":"expression"}},"expr":"'f' if n1 > n2 and n1 > sqrt(eval_val) else ('g' if n2 > sqrt(eval_val) else 'h')","outputs":{"value":{"type":"expression"}},"executor":"expr:power_eval_compare.n3","verifier":"exact:power_eval_compare.n3"}],"final":"n3.value"}}
{"id":"asymptote_vertex_y","atoms":["func.hyperbola.vertical_asymptote","func.hyperbola.horizontal_asymptote","func.quad_general.y_intercept"],"template":"The hyperbola y = {a_val}/(x−{b_val}) + {d_val} has vertical asymptote x = p and horizontal asymptote y = q. A quadratic y = {a_quad}x² + bx + q has axis x = p. Find the vertex y-coordinate.","vars":{"a_val":{"type":"int","min":1,"max":9},"b_val":{"type":"int","min":1,"max":6},"d_val":{"type":"int","min":-4,"max":4},"a_quad":{"type":"int","min":1,"max":3,"exclude":[0]}},"solver":"asymptote_vertex_y","graph":{"nodes":[{"node_id":"n1","atom_id":"func.hyperbola.vertical_asymptote","inputs":{"b_val":{"source":"question","field":"b_val","type":"expression"}},"expr":"b_val","outputs":{"value":{"type":"expression"}},"executor":"expr:asymptote_vertex_y.n1","verifier":"exact:asymptote_vertex_y.n1"},{"node_id":"n2","atom_id":"func.hyperbola.horizontal_asymptote","inputs":{"d_val":{"source":"question","field":"d_val","type":"expression"}},"expr":"d_val","outputs":{"value":{"type":"expression"}},"executor":"expr:asymptote_vertex_y.n2","verifier":"exact:asymptote_vertex_y.n2"},{"node_id":"n3","atom_id":"func.quad_general.y_intercept","inputs":{"n2":{"source":"n2","field":"value","type":"expression"}},"expr":"n2","outputs":{"value":{"type":"expression"}},"executor":"expr:asymptote_vertex_y.n3","verifier":"exact:asymptote_vertex_y.n3"},{"node_id":"n4","atom_id":"func.quad_general.y_intercept","inputs":{"a_quad":{"source":"question","field":"a_quad","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"},"n3":{"source":"n3","field":"value","type":"expression"}},"expr":"str(-a_quad*n1**2 + n3)","outputs":{"value":{"type":"expression"}},"executor":"expr:asymptote_vertex_y.n4","verifier":"exact:asymptote_vertex_y.n4"}],"final":"n4.value"}}
{"id":"invprop_k_solve","atoms":["func.inv_proportion.definition","func.pow.neg1"],"template":"y is inversely proportional to x with k = {k_val}. Solve k/x = {target_val} for x. State the asymptotes of y = k/x.","vars":{"k_val":{"type":"int","min":12,"max":60},"target_val":{"type":"int","min":2,"max":6}},"solver":"invprop_k_solve","graph":{"nodes":[{"node_id":"n1","atom_id":"func.inv_proportion.definition","inputs":{"k_val":{"source":"question","field":"k_val","type":"expression"}},"expr":"k_val","outputs":{"value":{"type":"expression"}},"executor":"expr:invprop_k_solve.n1","verifier":"exact:invprop_k_solve.n1"},{"node_id":"n2","atom_id":"func.pow.neg1","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"target_val":{"source":"question","field":"target_val","type":"expression"}},"expr":"str(Fraction(n1, target_val))","outputs":{"value":{"type":"expression"}},"executor":"expr:invprop_k_solve.n2","verifier":"exact:invprop_k_solve.n2"}],"final":"n2.value"}}
{"id":"quadratic_expand_compare","atoms":["func.poly.quadratic_two_linear","func.poly.quadratic_repeated"],"template":"Expand (x−{a_val})(x−{b_val}) and (x−{rep_val})². Find the difference between the constant terms of these two expansions.","vars":{"a_val":{"type":"int","min":1,"max":9},"b_val":{"type":"int","min":1,"max":9,"exclude":["a_val"]},"rep_val":{"type":"int","min":1,"max":9}},"solver":"quadratic_expand_compare","graph":{"nodes":[{"node_id":"n1","atom_id":"func.poly.quadratic_two_linear","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"b_val":{"source":"question","field":"b_val","type":"expression"}},"expr":"a_val * b_val","outputs":{"value":{"type":"expression"}},"executor":"expr:quadratic_expand_compare.n1","verifier":"exact:quadratic_expand_compare.n1"},{"node_id":"n2","atom_id":"func.poly.quadratic_repeated","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"rep_val":{"source":"question","field":"rep_val","type":"expression"}},"expr":"str(rep_val*rep_val - n1)","outputs":{"value":{"type":"expression"}},"executor":"expr:quadratic_expand_compare.n2","verifier":"exact:quadratic_expand_compare.n2"}],"final":"n2.value"}}
{"id":"cubic_compare_forms","atoms":["func.poly.cubic_three_linear","func.poly.cubic_repeated"],"template":"Expand (x−{a_val})(x−{b_val})(x−{c_val}) and (x−{rep_val})³. Which has the larger coefficient of x² (less negative)?","vars":{"a_val":{"type":"int","min":1,"max":5},"b_val":{"type":"int","min":1,"max":5,"exclude":["a_val"]},"c_val":{"type":"int","min":1,"max":5,"exclude":["a_val","b_val"]},"rep_val":{"type":"int","min":1,"max":5}},"solver":"cubic_compare_forms","graph":{"nodes":[{"node_id":"n1","atom_id":"func.poly.cubic_three_linear","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"b_val":{"source":"question","field":"b_val","type":"expression"},"c_val":{"source":"question","field":"c_val","type":"expression"}},"expr":"-(a_val + b_val + c_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:cubic_compare_forms.n1","verifier":"exact:cubic_compare_forms.n1"},{"node_id":"n2","atom_id":"func.poly.cubic_repeated","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"rep_val":{"source":"question","field":"rep_val","type":"expression"}},"expr":"'three_linear' if n1 > -3*rep_val else 'repeated'","outputs":{"value":{"type":"expression"}},"executor":"expr:cubic_compare_forms.n2","verifier":"exact:cubic_compare_forms.n2"}],"final":"n2.value"}}
{"id":"factor_theorem_verify","atoms":["func.notation.evaluate","func.poly.factor_theorem"],"template":"For p(x) = x³ + {b_val}x² + {c_val}x + {d_val}, is (x−{a_val}) a factor?","vars":{"b_val":{"type":"int","min":-9,"max":9},"c_val":{"type":"int","min":-9,"max":9},"a_val":{"type":"int","min":-6,"max":6,"exclude":[0]},"is_factor":{"type":"choice","values":[0,1]},"nudge":{"type":"int","min":1,"max":9}},"derive":{"d_val":"-(a_val**3 + b_val*a_val**2 + c_val*a_val) + (0 if is_factor else nudge)"},"solver":"factor_theorem_verify","graph":{"nodes":[{"node_id":"n1","atom_id":"func.notation.evaluate","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"b_val":{"source":"question","field":"b_val","type":"expression"},"c_val":{"source":"question","field":"c_val","type":"expression"},"d_val":{"source":"question","field":"d_val","type":"expression"}},"expr":"poly_factor_theorem(a_val, b_val, c_val, d_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:factor_theorem_verify.n1","verifier":"exact:factor_theorem_verify.n1"},{"node_id":"n2","atom_id":"func.poly.factor_theorem","inputs":{"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"'factor' if n1 == 0 else 'not a factor'","outputs":{"value":{"type":"expression"}},"executor":"expr:factor_theorem_verify.n2","verifier":"exact:factor_theorem_verify.n2"}],"final":"n2.value"}}
{"id":"cubic_factor_quotient","atoms":["func.poly.factor_theorem","func.poly.cubic_factor_quotient"],"template":"Given (x−{a_val}) is a factor of p(x) = x³ + {b_val}x² + {c_val}x + {d_val}, find the quadratic quotient q(x) where p(x) = (x−{a_val})q(x).","vars":{"a_val":{"type":"int","min":-6,"max":6,"exclude":[0]},"b_val":{"type":"int","min":-9,"max":9},"c_val":{"type":"int","min":-9,"max":9}},"derive":{"d_val":"-(a_val**3 + b_val*a_val**2 + c_val*a_val)","a":"a_val","b":"b_val","c":"c_val","d":"d_val"},"solver":"poly_cubic_factor_quotient","graph":{"nodes":[{"node_id":"n1","atom_id":"func.poly.factor_theorem","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"b_val":{"source":"question","field":"b_val","type":"expression"},"c_val":{"source":"question","field":"c_val","type":"expression"},"d_val":{"source":"question","field":"d_val","type":"expression"}},"expr":"poly_factor_theorem(a_val, b_val, c_val, d_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:cubic_factor_quotient.n1","verifier":"exact:cubic_factor_quotient.n1"},{"node_id":"n2","atom_id":"func.poly.cubic_factor_quotient","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"b_val":{"source":"question","field":"b_val","type":"expression"},"c_val":{"source":"question","field":"c_val","type":"expression"},"d_val":{"source":"question","field":"d_val","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"poly_cubic_factor_quotient(a_val, b_val, c_val, d_val) if n1 == 0 else 'not a factor'","outputs":{"value":{"type":"expression"}},"executor":"expr:cubic_factor_quotient.n2","verifier":"exact:cubic_factor_quotient.n2"}],"final":"n2.value"}}
{"id":"circle_standard_point","atoms":["func.graph_relation.standard_circle","func.notation.evaluate"],"template":"The circle x² + y² = {r_sq_val} has radius r = {r_val}. Find y when x = {x_val}. Give both possible values.","vars":{"r_val":{"type":"int","min":2,"max":10},"x_val":{"type":"int","min":-9,"max":9}},"derive":{"r_sq_val":"r_val * r_val"},"constraints":["abs(x_val) <= r_val"],"solver":"circle_standard_point","graph":{"nodes":[{"node_id":"n1","atom_id":"func.graph_relation.standard_circle","inputs":{"r_sq_val":{"source":"question","field":"r_sq_val","type":"expression"},"x_val":{"source":"question","field":"x_val","type":"expression"}},"expr":"r_sq_val - x_val**2","outputs":{"value":{"type":"expression"}},"executor":"expr:circle_standard_point.n1","verifier":"exact:circle_standard_point.n1"},{"node_id":"n2","atom_id":"func.notation.evaluate","inputs":{"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"'%s, -%s' % (sqrt(n1), sqrt(n1)) if n1 > 0 else ('0' if n1 == 0 else 'undefined')","outputs":{"value":{"type":"expression"}},"executor":"expr:circle_standard_point.n2","verifier":"exact:circle_standard_point.n2"}],"final":"n2.value"}}
{"id":"repeated_root_expanded","atoms":["func.poly.repeated_root","func.poly.factor_theorem"],"template":"Expand p(x) = (x−{a_val})²(x−{b_val}) to the form x³ + bx² + cx + d. Find b + c + d.","vars":{"a_val":{"type":"int","min":-6,"max":6,"exclude":[0]},"b_val":{"type":"int","min":-6,"max":6,"exclude":["a_val"]}},"solver":"repeated_root_expanded","graph":{"nodes":[{"node_id":"n1","atom_id":"func.poly.repeated_root","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"b_val":{"source":"question","field":"b_val","type":"expression"}},"expr":"-(2*a_val + b_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:repeated_root_expanded.n1","verifier":"exact:repeated_root_expanded.n1"},{"node_id":"n2","atom_id":"func.poly.repeated_root","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"b_val":{"source":"question","field":"b_val","type":"expression"}},"expr":"a_val**2 + 2*a_val*b_val","outputs":{"value":{"type":"expression"}},"executor":"expr:repeated_root_expanded.n2","verifier":"exact:repeated_root_expanded.n2"},{"node_id":"n3","atom_id":"func.poly.repeated_root","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"b_val":{"source":"question","field":"b_val","type":"expression"}},"expr":"-(a_val**2 * b_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:repeated_root_expanded.n3","verifier":"exact:repeated_root_expanded.n3"},{"node_id":"n4","atom_id":"func.poly.factor_theorem","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"n2":{"source":"n2","field":"value","type":"expression"},"n3":{"source":"n3","field":"value","type":"expression"}},"expr":"str(n1 + n2 + n3)","outputs":{"value":{"type":"expression"}},"executor":"expr:repeated_root_expanded.n4","verifier":"exact:repeated_root_expanded.n4"}],"final":"n4.value"}}
{"id":"transform_horizontal_sequence","atoms":["func.transform.horizontal_translation","func.transform.horizontal_dilation"],"template":"Starting with f(x) = x², apply a horizontal dilation by factor 1/{k_val}, then translate horizontally by {shift_val} units right. Write the final equation in the form y = (x−h)².","vars":{"k_val":{"type":"int","min":2,"max":5},"shift_val":{"type":"int","min":-6,"max":6,"exclude":[0]}},"solver":"transform_horizontal_sequence","graph":{"nodes":[{"node_id":"n1","atom_id":"func.transform.horizontal_translation","inputs":{"k_val":{"source":"question","field":"k_val","type":"expression"},"shift_val":{"source":"question","field":"shift_val","type":"expression"}},"expr":"shift_val * k_val","outputs":{"value":{"type":"expression"}},"executor":"expr:transform_horizontal_sequence.n1","verifier":"exact:transform_horizontal_sequence.n1"},{"node_id":"n2","atom_id":"func.transform.horizontal_dilation","inputs":{"k_val":{"source":"question","field":"k_val","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"('y = (%sx - %s)²' % (k_val, n1)) if n1 > 0 else ('y = (%sx + %s)²' % (k_val, -n1))","outputs":{"value":{"type":"expression"}},"executor":"expr:transform_horizontal_sequence.n2","verifier":"exact:transform_horizontal_sequence.n2"}],"final":"n2.value"}}
{"id":"transform_reverse_find_original","atoms":["func.transform.horizontal_translation","func.transform.vertical_translation","func.transform.vertical_dilation"],"template":"After applying vertical dilation by {c_val}, then translating {v_val} units up and {h_val} units right to f(x) = x², the vertex is at ({final_h}, {final_v}). Find the original vertex before transformations.","vars":{"c_val":{"type":"int","min":-9,"max":9,"exclude":[0]},"v_val":{"type":"int","min":-9,"max":9},"h_val":{"type":"int","min":-6,"max":6},"final_h":{"type":"int","min":-6,"max":6},"final_v":{"type":"int","min":-9,"max":9}},"solver":"transform_reverse_find_original","graph":{"nodes":[{"node_id":"n1","atom_id":"func.transform.horizontal_translation","inputs":{"final_h":{"source":"question","field":"final_h","type":"expression"},"h_val":{"source":"question","field":"h_val","type":"expression"}},"expr":"final_h - h_val","outputs":{"value":{"type":"expression"}},"executor":"expr:transform_reverse_find_original.n1","verifier":"exact:transform_reverse_find_original.n1"},{"node_id":"n2","atom_id":"func.transform.vertical_translation","inputs":{"final_v":{"source":"question","field":"final_v","type":"expression"},"v_val":{"source":"question","field":"v_val","type":"expression"}},"expr":"final_v - v_val","outputs":{"value":{"type":"expression"}},"executor":"expr:transform_reverse_find_original.n2","verifier":"exact:transform_reverse_find_original.n2"},{"node_id":"n3","atom_id":"func.transform.vertical_dilation","inputs":{"c_val":{"source":"question","field":"c_val","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"},"n2":{"source":"n2","field":"value","type":"expression"}},"expr":"'(%s, %s)' % (n1, pf(n2, c_val))","outputs":{"value":{"type":"expression"}},"executor":"expr:transform_reverse_find_original.n3","verifier":"exact:transform_reverse_find_original.n3"}],"final":"n3.value"}}
{"id":"transform_compare_outputs","atoms":["func.transform.vertical_dilation","func.transform.vertical_translation"],"template":"For f(x) = x², compare two transformations: (1) vertical dilation by {c_val} then shift up by {a_val}, (2) shift up by {a_val} then vertical dilation by {c_val}. At x = {eval_x}, which gives the larger y-value?","vars":{"c_val":{"type":"int","min":2,"max":5},"a_val":{"type":"int","min":-9,"max":9,"exclude":[0]},"eval_x":{"type":"int","min":1,"max":5}},"solver":"transform_compare_outputs","graph":{"nodes":[{"node_id":"n1","atom_id":"func.transform.vertical_dilation","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"c_val":{"source":"question","field":"c_val","type":"expression"},"eval_x":{"source":"question","field":"eval_x","type":"expression"}},"expr":"c_val * eval_x**2 + a_val","outputs":{"value":{"type":"expression"}},"executor":"expr:transform_compare_outputs.n1","verifier":"exact:transform_compare_outputs.n1"},{"node_id":"n2","atom_id":"func.transform.vertical_translation","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"c_val":{"source":"question","field":"c_val","type":"expression"},"eval_x":{"source":"question","field":"eval_x","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"'dilation_first' if n1 > c_val*(eval_x**2 + a_val) else 'translation_first'","outputs":{"value":{"type":"expression"}},"executor":"expr:transform_compare_outputs.n2","verifier":"exact:transform_compare_outputs.n2"}],"final":"n2.value"}}
{"id":"transform_horizontal_dilation_eval","atoms":["func.transform.horizontal_translation","func.transform.horizontal_dilation"],"template":"Starting with f(x) = x², apply horizontal dilation by factor 1/{k_val}, then shift {h_val} units right. Evaluate the transformed function at x = {eval_x}.","vars":{"k_val":{"type":"int","min":1,"max":5},"h_val":{"type":"int","min":-6,"max":6},"eval_x":{"type":"int","min":-5,"max":5}},"solver":"transform_horizontal_dilation_eval","graph":{"nodes":[{"node_id":"n1","atom_id":"func.transform.horizontal_translation","inputs":{"eval_x":{"source":"question","field":"eval_x","type":"expression"},"h_val":{"source":"question","field":"h_val","type":"expression"}},"expr":"eval_x - h_val","outputs":{"value":{"type":"expression"}},"executor":"expr:transform_horizontal_dilation_eval.n1","verifier":"exact:transform_horizontal_dilation_eval.n1"},{"node_id":"n2","atom_id":"func.transform.horizontal_dilation","inputs":{"k_val":{"source":"question","field":"k_val","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"str((k_val * n1)**2)","outputs":{"value":{"type":"expression"}},"executor":"expr:transform_horizontal_dilation_eval.n2","verifier":"exact:transform_horizontal_dilation_eval.n2"}],"final":"n2.value"}}
{"id":"combination_boundary_sum","atoms":["prob.combination.boundary_zero","prob.combination.boundary_self","prob.combination.formula"],"template":"Express C({n_val}, 0) + C({n_val}, {n_val}) + C({n_val}, 1) as a fraction of C({n_val}, {r_val}).","vars":{"n_val":{"type":"int","min":3,"max":12},"r_val":{"type":"int","min":2,"max":6}},"constraints":["r_val <= n_val"],"solver":"combination_boundary_sum","graph":{"nodes":[{"node_id":"n1","atom_id":"prob.combination.boundary_zero","inputs":{"n_val":{"source":"question","field":"n_val","type":"expression"}},"expr":"comb(n_val, 0)","outputs":{"value":{"type":"expression"}},"executor":"expr:combination_boundary_sum.n1","verifier":"exact:combination_boundary_sum.n1"},{"node_id":"n2","atom_id":"prob.combination.boundary_self","inputs":{"n_val":{"source":"question","field":"n_val","type":"expression"}},"expr":"comb(n_val, n_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:combination_boundary_sum.n2","verifier":"exact:combination_boundary_sum.n2"},{"node_id":"n3","atom_id":"prob.combination.formula","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"n2":{"source":"n2","field":"value","type":"expression"},"n_val":{"source":"question","field":"n_val","type":"expression"},"r_val":{"source":"question","field":"r_val","type":"expression"}},"expr":"pf(n1 + n2 + comb(n_val, 1), comb(n_val, r_val))","outputs":{"value":{"type":"expression"}},"executor":"expr:combination_boundary_sum.n3","verifier":"exact:combination_boundary_sum.n3"}],"final":"n3.value"}}
{"id":"combination_sum_adjacent","atoms":["prob.combination.range","prob.combination.formula"],"template":"Calculate C({n_val}, {r_val}) + C({n_val}, {r_plus_1_val}). Express as a single value.","vars":{"n_val":{"type":"int","min":5,"max":12},"r_val":{"type":"int","min":1,"max":5}},"derive":{"r_plus_1_val":"r_val + 1"},"constraints":["r_plus_1_val <= n_val"],"solver":"combination_sum_adjacent","graph":{"nodes":[{"node_id":"n1","atom_id":"prob.combination.range","inputs":{"n_val":{"source":"question","field":"n_val","type":"expression"}},"expr":"n_val","outputs":{"value":{"type":"expression"}},"executor":"expr:combination_sum_adjacent.n1","verifier":"exact:combination_sum_adjacent.n1"},{"node_id":"n2","atom_id":"prob.combination.formula","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"r_plus_1_val":{"source":"question","field":"r_plus_1_val","type":"expression"},"r_val":{"source":"question","field":"r_val","type":"expression"}},"expr":"str(comb(n1, r_val) + comb(n1, r_plus_1_val))","outputs":{"value":{"type":"expression"}},"executor":"expr:combination_sum_adjacent.n2","verifier":"exact:combination_sum_adjacent.n2"}],"final":"n2.value"}}
{"id":"binom_term_compare","atoms":["prob.binom.form","prob.binom.coeff"],"template":"For (x+y)^{n_val}, the coefficients of x^{n_minus_k1_val}y^{k1_val} and x^{n_minus_k2_val}y^{k2_val} are compared. Which is larger — first, second, or equal?","vars":{"n_val":{"type":"int","min":5,"max":12},"k1_val":{"type":"int","min":1,"max":5},"k2_val":{"type":"int","min":1,"max":5,"exclude":["k1_val"]}},"derive":{"n_minus_k1_val":"n_val - k1_val","n_minus_k2_val":"n_val - k2_val"},"constraints":["k1_val <= n_val","k2_val <= n_val"],"solver":"binom_term_compare","graph":{"nodes":[{"node_id":"n1","atom_id":"prob.binom.form","inputs":{"n_val":{"source":"question","field":"n_val","type":"expression"}},"expr":"n_val","outputs":{"value":{"type":"expression"}},"executor":"expr:binom_term_compare.n1","verifier":"exact:binom_term_compare.n1"},{"node_id":"n2","atom_id":"prob.binom.coeff","inputs":{"k1_val":{"source":"question","field":"k1_val","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"comb(n1, k1_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:binom_term_compare.n2","verifier":"exact:binom_term_compare.n2"},{"node_id":"n3","atom_id":"prob.binom.coeff","inputs":{"k2_val":{"source":"question","field":"k2_val","type":"expression"},"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"comb(n1, k2_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:binom_term_compare.n3","verifier":"exact:binom_term_compare.n3"},{"node_id":"n4","atom_id":"prob.binom.coeff","inputs":{"n2":{"source":"n2","field":"value","type":"expression"},"n3":{"source":"n3","field":"value","type":"expression"}},"expr":"'first' if n2 > n3 else ('second' if n3 > n2 else 'equal')","outputs":{"value":{"type":"expression"}},"executor":"expr:binom_term_compare.n4","verifier":"exact:binom_term_compare.n4"}],"final":"n4.value"}}
{"id":"binom_specific_term_value","atoms":["prob.binom.form","prob.binom.coeff"],"template":"For (2x+y)^{n_val}, find the coefficient of x^{n_minus_k_val}y^{k_val}.","vars":{"n_val":{"type":"int","min":4,"max":10},"k_val":{"type":"int","min":0,"max":6}},"derive":{"n_minus_k_val":"n_val - k_val"},"constraints":["k_val <= n_val"],"solver":"binom_specific_term_value","graph":{"nodes":[{"node_id":"n1","atom_id":"prob.binom.form","inputs":{"n_minus_k_val":{"source":"question","field":"n_minus_k_val","type":"expression"}},"expr":"2 ** n_minus_k_val","outputs":{"value":{"type":"expression"}},"executor":"expr:binom_specific_term_value.n1","verifier":"exact:binom_specific_term_value.n1"},{"node_id":"n2","atom_id":"prob.binom.coeff","inputs":{"k_val":{"source":"question","field":"k_val","type":"expression"},"n_val":{"source":"question","field":"n_val","type":"expression"}},"expr":"comb(n_val, k_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:binom_specific_term_value.n2","verifier":"exact:binom_specific_term_value.n2"},{"node_id":"n4","atom_id":null,"inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"n2":{"source":"n2","field":"value","type":"expression"}},"expr":"str(n1 * n2)","outputs":{"value":{"type":"expression"}},"executor":"expr:binom_specific_term_value.n4","verifier":"exact:binom_specific_term_value.n4"}],"final":"n4.value"}}
{"id":"pascal_symmetry_sum","atoms":["prob.pascal.structure","prob.pascal.row_sum"],"template":"In row {n_val} of Pascal's triangle, express C({n_val}, {r_val}) + C({n_val}, {n_minus_r_val}) as a fraction of the row sum 2^{n_val}.","vars":{"n_val":{"type":"int","min":4,"max":12},"r_val":{"type":"int","min":0,"max":6}},"derive":{"n_minus_r_val":"n_val - r_val"},"constraints":["r_val <= n_val"],"solver":"pascal_symmetry_sum","graph":{"nodes":[{"node_id":"n1","atom_id":"prob.pascal.structure","inputs":{"n_minus_r_val":{"source":"question","field":"n_minus_r_val","type":"expression"},"n_val":{"source":"question","field":"n_val","type":"expression"},"r_val":{"source":"question","field":"r_val","type":"expression"}},"expr":"comb(n_val, r_val) + comb(n_val, n_minus_r_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:pascal_symmetry_sum.n1","verifier":"exact:pascal_symmetry_sum.n1"},{"node_id":"n2","atom_id":"prob.pascal.row_sum","inputs":{"n_val":{"source":"question","field":"n_val","type":"expression"}},"expr":"2 ** n_val","outputs":{"value":{"type":"expression"}},"executor":"expr:pascal_symmetry_sum.n2","verifier":"exact:pascal_symmetry_sum.n2"},{"node_id":"n3","atom_id":"prob.pascal.row_sum","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"n2":{"source":"n2","field":"value","type":"expression"}},"expr":"pf(n1, n2)","outputs":{"value":{"type":"expression"}},"executor":"expr:pascal_symmetry_sum.n3","verifier":"exact:pascal_symmetry_sum.n3"}],"final":"n3.value"}}
{"id":"outcome_sample_space_count","atoms":["prob.outcome.definition","prob.sample_space.definition"],"template":"{art} {die_faces}-sided die and a {coin_sides}-sided die are rolled. How many outcomes are in the sample space?","vars":{"die_faces":{"type":"int","min":4,"max":15},"coin_sides":{"type":"int","min":2,"max":12}},"derive":{"art":"'An' if die_faces in (8, 11, 18) else 'A'"},"solver":"outcome_sample_space_count","graph":{"nodes":[{"node_id":"n1","atom_id":"prob.outcome.definition","inputs":{"coin_sides":{"source":"question","field":"coin_sides","type":"expression"},"die_faces":{"source":"question","field":"die_faces","type":"expression"}},"expr":"die_faces * coin_sides","outputs":{"value":{"type":"expression"}},"executor":"expr:outcome_sample_space_count.n1","verifier":"exact:outcome_sample_space_count.n1"},{"node_id":"n2","atom_id":"prob.sample_space.definition","inputs":{"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"str(n1)","outputs":{"value":{"type":"expression"}},"executor":"expr:outcome_sample_space_count.n2","verifier":"exact:outcome_sample_space_count.n2"}],"final":"n2.value"}}
{"id":"event_complement_size","atoms":["prob.event.definition","prob.sample_space.definition"],"template":"The sample space S has {total_val} outcomes. Event A has {a_val} outcomes. What fraction of S is not in A?","vars":{"total_val":{"type":"int","min":10,"max":50},"a_val":{"type":"int","min":1,"max":25}},"solver":"event_complement_size","graph":{"nodes":[{"node_id":"n1","atom_id":"prob.event.definition","inputs":{"a_val":{"source":"question","field":"a_val","type":"expression"},"total_val":{"source":"question","field":"total_val","type":"expression"}},"expr":"total_val - a_val","outputs":{"value":{"type":"expression"}},"executor":"expr:event_complement_size.n1","verifier":"exact:event_complement_size.n1"},{"node_id":"n2","atom_id":"prob.sample_space.definition","inputs":{"n1":{"source":"n1","field":"value","type":"expression"},"total_val":{"source":"question","field":"total_val","type":"expression"}},"expr":"pf(n1, total_val)","outputs":{"value":{"type":"expression"}},"executor":"expr:event_complement_size.n2","verifier":"exact:event_complement_size.n2"}],"final":"n2.value"}}
{"id":"outcome_counting_principle","atoms":["prob.outcome.definition","prob.sample_space.definition"],"template":"A {choice1_val}-item menu and a {choice2_val}-item drink list are available. One item from each is chosen. Find the total number of outcomes in the sample space.","vars":{"choice1_val":{"type":"int","min":3,"max":10},"choice2_val":{"type":"int","min":2,"max":8}},"solver":"outcome_counting_principle","graph":{"nodes":[{"node_id":"n1","atom_id":"prob.outcome.definition","inputs":{"choice1_val":{"source":"question","field":"choice1_val","type":"expression"},"choice2_val":{"source":"question","field":"choice2_val","type":"expression"}},"expr":"choice1_val * choice2_val","outputs":{"value":{"type":"expression"}},"executor":"expr:outcome_counting_principle.n1","verifier":"exact:outcome_counting_principle.n1"},{"node_id":"n2","atom_id":"prob.sample_space.definition","inputs":{"n1":{"source":"n1","field":"value","type":"expression"}},"expr":"str(n1)","outputs":{"value":{"type":"expression"}},"executor":"expr:outcome_counting_principle.n2","verifier":"exact:outcome_counting_principle.n2"}],"final":"n2.value"}}
