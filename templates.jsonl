{"id":"direct_prop.constant_ratio","unit":"MM1","atom":"func.direct_proportion.constant_ratio","template":"If y is directly proportional to x and y = {y1} when x = {x1}, find the constant of proportionality k.","vars":{"y1":{"type":"int","min":1,"max":20},"x1":{"type":"int","min":1,"max":10}},"solver":"direct_prop_constant_ratio"}
{"id":"func_linear_solve_one_step","unit":"MM1","atom":"func.linear_solve.one_step","template":"Solve {lhs} = {b} for x.","vars":{"a":{"type":"int","min":-12,"max":12,"exclude":[0]},"b":{"type":"int","min":-24,"max":24}},"derive":{"lhs":"poly([(1,a)])"},"solver":"func_linear_solve_one_step"}
{"id":"quad_general_axis","unit":"MM1","atom":"func.quad_general.axis","template":"Find the x-coordinate of the axis of symmetry of y = {qd}.","vars":{"a":{"type":"int","min":-6,"max":6,"exclude":[0]},"b":{"type":"int","min":-6,"max":6},"c":{"type":"int","min":-6,"max":6}},"derive":{"qd":"quad(a,b,c)"},"solver":"quad_general_axis"}
{"id":"poly_quadratic_two_linear","unit":"MM1","atom":"func.poly.quadratic_two_linear","template":"Expand {fa}{fb}.","vars":{"a":{"type":"int","min":-6,"max":6},"b":{"type":"int","min":-6,"max":6}},"derive":{"fa":"linfac(a)","fb":"linfac(b)"},"solver":"poly_quadratic_two_linear"}
{"id":"poly_quadratic_repeated","unit":"MM1","atom":"func.poly.quadratic_repeated","template":"Expand {fa}².","vars":{"a":{"type":"int","min":-6,"max":6}},"derive":{"fa":"linfac(a)"},"solver":"poly_quadratic_repeated","finite_support":true}
{"id":"poly_factor_theorem","unit":"MM1","atom":"func.poly.factor_theorem","template":"Let p(x) = {cb}. Is {fa} a factor of p(x)?","vars":{"a":{"type":"int","min":1,"max":4},"b":{"type":"int","min":-6,"max":2},"c":{"type":"int","min":-4,"max":4},"off":{"type":"choice","values":[0,0,1,-1,2,-2]}},"derive":{"d":"-(a**3 + b*a**2 + c*a) + off","cb":"cubic(1,b,c,d)","fa":"linfac(a)"},"solver":"poly_factor_theorem"}
{"id":"poly_cubic_factor_quotient","unit":"MM1","atom":"func.poly.cubic_factor_quotient","template":"Given that {fa} is a factor of {cb}, find q(x) such that p(x) = {fa}q(x).","vars":{"a":{"type":"int","min":1,"max":4},"b":{"type":"int","min":-6,"max":2},"c":{"type":"int","min":-4,"max":4}},"derive":{"d":"-(a**3 + b*a**2 + c*a)","cb":"cubic(1,b,c,d)","fa":"linfac(a)"},"constraints":["a + b != 0"],"solver":"poly_cubic_factor_quotient"}
{"id":"func_evaluate","unit":"MM1","atom":"func.notation.evaluate","template":"Let f(x) = {qd}. Find f({k}).","vars":{"a":{"type":"int","min":1,"max":4},"b":{"type":"int","min":-6,"max":6},"c":{"type":"int","min":-6,"max":6},"k":{"type":"int","min":-4,"max":4}},"derive":{"qd":"quad(a,b,c)"},"solver":"func_evaluate"}
{"id":"func_vertical_translation","unit":"MM1","atom":"func.transform.vertical_translation","template":"A point on y = f(x) has y-coordinate {q}. Give the y-coordinate of the corresponding point on y = f(x){at}.","vars":{"p":{"type":"int","min":-6,"max":6},"q":{"type":"int","min":-6,"max":6},"a":{"type":"int","min":-6,"max":6,"exclude":[0]}},"derive":{"at":"term(a)"},"solver":"transform_v_translate_y"}
{"id":"func_horizontal_translation","unit":"MM1","atom":"func.transform.horizontal_translation","template":"A point on y = f(x) has x-coordinate {p}. Give the x-coordinate of the corresponding point on y = f({xb}).","vars":{"p":{"type":"int","min":-6,"max":6},"q":{"type":"int","min":-6,"max":6},"b":{"type":"int","min":-6,"max":6,"exclude":[0]}},"derive":{"xb":"poly([(1,1),(0,b)])"},"solver":"transform_h_translate_x"}
{"id":"func_vertical_dilation","unit":"MM1","atom":"func.transform.vertical_dilation","template":"A point on y = f(x) has y-coordinate {q}. Give the y-coordinate of the corresponding point on y = {c}f(x).","vars":{"p":{"type":"int","min":-6,"max":6},"q":{"type":"int","min":-6,"max":6,"exclude":[0]},"c":{"type":"int","min":-6,"max":6,"exclude":[0,1]}},"solver":"transform_v_dilate_y"}
{"id":"func_horizontal_dilation","unit":"MM1","atom":"func.transform.horizontal_dilation","template":"A point on y = f(x) has x-coordinate {p}. Give the x-coordinate of the corresponding point on y = f({kx}).","vars":{"p":{"type":"int","min":-6,"max":6,"exclude":[0]},"q":{"type":"int","min":-6,"max":6},"k":{"type":"int","min":-6,"max":6,"exclude":[0,1]}},"derive":{"kx":"coef(k, 'x')"},"solver":"transform_h_dilate_x"}
{"id":"func_linear_solve_one_step_alt","unit":"MM1","atom":"func.linear_solve.one_step","template":"Solve the linear equation {lhs} = {b} for x.","vars":{"a":{"type":"int","min":-9,"max":9,"exclude":[0]},"b":{"type":"int","min":-20,"max":20}},"derive":{"lhs":"poly([(1,a)])"},"solver":"func_linear_solve_one_step"}
{"id":"hyperbola_vertical_asymptote","unit":"MM1","atom":"func.hyperbola.vertical_asymptote","template":"Give the vertical asymptote of y = {a}/{fb}.","vars":{"a":{"type":"int","min":-9,"max":9,"exclude":[0]},"b":{"type":"int","min":-8,"max":8}},"derive":{"fb":"linfac(b)"},"solver":"hyperbola_vertical_asymptote"}
{"id":"hyperbola_horizontal_asymptote","unit":"MM1","atom":"func.hyperbola.horizontal_asymptote","template":"Give the horizontal asymptote of y = {a}/{fb}{dt}.","vars":{"a":{"type":"int","min":-9,"max":9,"exclude":[0]},"b":{"type":"int","min":-8,"max":8},"d":{"type":"int","min":-9,"max":9}},"derive":{"fb":"linfac(b)","dt":"term(d)"},"solver":"hyperbola_horizontal_asymptote"}
{"id":"inv_proportion_constant","unit":"MM1","atom":"func.inv_proportion.definition","template":"y is inversely proportional to x, and y = {y1} when x = {x1}. Find the constant k in y = k/x.","vars":{"x1":{"type":"int","min":1,"max":12},"y1":{"type":"int","min":1,"max":12}},"solver":"inv_proportion_equation"}
{"id":"quad_general_y_intercept","unit":"MM1","atom":"func.quad_general.y_intercept","template":"Find the y-coordinate of the y-intercept of y = {qd}.","vars":{"a":{"type":"int","min":-5,"max":5,"exclude":[0]},"b":{"type":"int","min":-9,"max":9},"c":{"type":"int","min":-9,"max":9}},"derive":{"qd":"quad(a,b,c)"},"solver":"quad_general_y_intercept"}
{"id":"sqrt_principal","unit":"MM1","atom":"func.sqrt.principal","template":"Give the principal (non-negative) square root of {t_val}.","vars":{"r":{"type":"int","min":2,"max":15}},"derive":{"t_val":"r * r"},"solver":"sqrt_principal","finite_support":true}
